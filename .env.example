# Ollama AI configuration.
# Leave OLLAMA_URL and OLLAMA_MODEL blank to choose defaults automatically.
# With OLLAMA_API_KEY set, defaults to Ollama Cloud; without it, defaults to local Ollama.
OLLAMA_API_KEY=
OLLAMA_URL=
OLLAMA_MODEL=

# Optional alternative cloud AI for the native desktop app (keep the real key in local .env only)
GEMINI_API_KEY=
